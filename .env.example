# Clerk publishable key for the SignMeUp app (safe to expose to the browser).
# Get it with `clerk env pull` after `clerk link`, or from dashboard.clerk.com → API keys.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...

# Optional: sdsu.edu addresses that become system administrators on their first sign-in.
VITE_ADMIN_EMAILS=you@sdsu.edu

# Server only (Vercel serverless functions): Supabase Postgres connection string.
# Set it on Vercel with `vercel env add DATABASE_URL production`; never prefix it with VITE_.
# Without it the app runs in local mode: changes stay in the browser and are not shared.
DATABASE_URL=postgresql://...
